# --- Discord (required) ---
# Bot token from https://discord.com/developers/applications (see README).
DISCORD_BOT_TOKEN=
# Your server ID (right-click server with Developer Mode on → Copy Server ID).
DISCORD_GUILD_ID=
# Category ID under which agent channels are created (right-click category → Copy Channel ID).
DISCORD_CATEGORY_ID=

# --- Agents ---
# Which provider new instances use when /new has no provider: kimi | claude | muse.
DEFAULT_PROVIDER=kimi
# Default working directory for new agent instances.
DEFAULT_WORKDIR=~
# Max agent turns running at once across all channels.
MAX_CONCURRENT_TURNS=4
# Harness log verbosity (DEBUG, INFO, WARNING, ...). Default INFO.
LOG_LEVEL=INFO

# --- Liveness / watchdog ---
# While a turn runs long, the bot posts a "still working" status in the channel
# this often (seconds). Default 1800 = every 30 min.
STATUS_UPDATE_INTERVAL=1800
# The bot rewrites data/heartbeat.json this often (seconds). Default 30.
HEARTBEAT_INTERVAL=30
# Watchdog process (started by run.sh): how often it checks the heartbeat
# (seconds, default 60), how stale the heartbeat must be before it alerts that
# the harness is down (default 180), and how long a turn may produce no output
# before it warns the agent may be hung (default 1800).
WATCHDOG_CHECK_INTERVAL=60
WATCHDOG_STALE_AFTER=180
WATCHDOG_STALL_AFTER=1800

# --- Kimi provider ---
KIMI_BIN=~/.kimi-code/bin/kimi
# Optional model alias passed via -m (leave empty to use your kimi config default).
KIMI_MODEL=

# --- Muse provider (muse exec) ---
# Path to the muse launcher script.
MUSE_BIN=~/.local/bin/muse
# Default model for new muse instances: spark-1.3 | spark-1.3-contributor | spark-1.2,
# or a full id (leave empty to use muse's settings.json default).
MUSE_MODEL=
# --reasoning-effort for muse: none|minimal|low|medium|high|xhigh|max|ultra (empty = default).
MUSE_EFFORT=

# --- Claude provider (Claude Code CLI) ---
# Path to the claude binary (default: "claude" on PATH).
CLAUDE_BIN=claude
# Default model for new claude instances: opus | sonnet | haiku | fable, or a full
# model ID (default claude-opus-5-5). Change per channel with /model.
CLAUDE_MODEL=claude-opus-5-5
# --permission-mode for claude -p. bypassPermissions = tools run without asking
# (like kimi's auto policy); acceptEdits/default are stricter but will block on
# prompts nobody can answer in print mode.
CLAUDE_PERMISSION_MODE=bypassPermissions

# --- Uptime log (discord-agent-uptime.service, /uptime) ---
# Seconds between internet checks (default 10). Only state changes are logged.
UPTIME_INTERVAL=10
# host:port targets probed by TCP connect; internet is up if any answers.
UPTIME_TARGETS=1.1.1.1:53,8.8.8.8:53,9.9.9.9:53

# --- WhatsApp mirror (optional, see README) ---
# Your own WhatsApp number with country code, digits only (e.g. 15551234567).
# Setting it turns the mirror on: link the separate bot account with /whatsapp,
# and each instance gets a "<name>-bot" group with you in it. Empty = off.
WHATSAPP_OWNER=
# The bot account's number. Optional: when set, /whatsapp gives a pairing code
# for it (enter on the bot phone) instead of a QR to scan.
WHATSAPP_BOT_NUMBER=

# --- Live web output through an existing Cloudflare Tunnel ---
# Public base URL whose tunnel forwards /agents/* to this machine's proxy
# (leave empty to disable). Agent subprocesses get AGENT_PUBLIC_BASE.
PUBLIC_BASE_URL=
# Local port for the agent reverse proxy (default 8471).
AGENT_PROXY_PORT=8471
