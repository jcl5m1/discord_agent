# --- Discord (required) ---
# Bot token from https://discord.com/developers/applications (see README).
DISCORD_BOT_TOKEN=
# Your server ID (right-click server with Developer Mode on → Copy Server ID).
DISCORD_GUILD_ID=
# Category ID under which agent channels are created (right-click category → Copy Channel ID).
DISCORD_CATEGORY_ID=

# --- Agents ---
# Which provider new instances use when /new has no provider: kimi | claude.
DEFAULT_PROVIDER=kimi
# Default working directory for new agent instances.
DEFAULT_WORKDIR=/home/jcl5m1
# Max agent turns running at once across all channels.
MAX_CONCURRENT_TURNS=4

# --- Kimi provider ---
KIMI_BIN=/home/jcl5m1/.kimi-code/bin/kimi
# Optional model alias passed via -m (leave empty to use your kimi config default).
KIMI_MODEL=

# --- Claude provider (Claude Code CLI) ---
# Path to the claude binary (default: "claude" on PATH).
CLAUDE_BIN=claude
# Default model for new claude instances: opus | sonnet | haiku | fable, or a full
# model ID (default claude-opus-5-5). Change per channel with /model.
CLAUDE_MODEL=claude-opus-5-5
# --permission-mode for claude -p. bypassPermissions = tools run without asking
# (like kimi's auto policy); acceptEdits/default are stricter but will block on
# prompts nobody can answer in print mode.
CLAUDE_PERMISSION_MODE=bypassPermissions

# --- Live web output through an existing Cloudflare Tunnel ---
# Public base URL whose tunnel forwards /agents/* to this machine's proxy
# (leave empty to disable). Agent subprocesses get AGENT_PUBLIC_BASE.
PUBLIC_BASE_URL=
# Local port for the agent reverse proxy (default 8471).
AGENT_PROXY_PORT=8471
